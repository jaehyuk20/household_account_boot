rules_version = '2';

// 모아봐요 가계부 — Firestore 보안 규칙
// 기록은 users/{로그인한 사람의 uid}/entries 아래에만 저장되고, 본인만 읽고 쓸 수 있습니다.
// users/{uid} 문서에는 시작 잔액(openingBalance)과 데이터 형식 버전(schema)만 저장합니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['type', 'cat', 'amount', 'delta', 'date', 'memo', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['type', 'cat', 'amount', 'delta', 'date', 'memo', 'createdAt'])
        && d.type in ['income', 'expense']
        && d.cat is string && d.cat.size() > 0 && d.cat.size() <= 32
        && d.amount is int && d.amount > 0 && d.amount <= 9999999999
        && d.delta is int && d.delta == (d.type == 'income' ? d.amount : -d.amount)
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.memo is string && d.memo.size() <= 40
        && d.createdAt is int
        && (!('updatedAt' in d) || d.updatedAt is int);
    }

    function validProfile(d) {
      return d.keys().hasOnly(['openingBalance', 'schema'])
        && (!('openingBalance' in d) || (d.openingBalance is int && d.openingBalance >= -99999999999 && d.openingBalance <= 99999999999))
        && (!('schema' in d) || (d.schema is int && d.schema >= 0 && d.schema <= 100));
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validProfile(request.resource.data);
    }

    match /users/{uid}/entries/{entryId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validEntry(request.resource.data);
    }
  }
}
