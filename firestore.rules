rules_version = '2';

// 모아봐요 가계부 — Firestore 보안 규칙
// 기록은 users/{로그인한 사람의 uid}/entries 아래에만 저장되고, 본인만 읽고 쓸 수 있습니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['type', 'cat', 'amount', 'date', 'memo', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['type', 'cat', 'amount', 'date', 'memo', 'createdAt'])
        && d.type in ['income', 'expense']
        && d.cat is string && d.cat.size() > 0 && d.cat.size() <= 32
        && d.amount is int && d.amount > 0 && d.amount <= 9999999999
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.memo is string && d.memo.size() <= 40
        && d.createdAt is int
        && (!('updatedAt' in d) || d.updatedAt is int);
    }

    match /users/{uid}/entries/{entryId} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validEntry(request.resource.data);
    }
  }
}
